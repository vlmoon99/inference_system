# ~/.config/systemd/user/inf-stack.service  (installed by deploy/install-unit.sh; linger keeps it at boot)
[Unit]
Description=inference_system: wait for the tailnet IP, then docker compose up (hosts/%I)
After=default.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=%h/Documents/dev/inference_system/deploy/boot-up.sh HOSTDIR
TimeoutStartSec=1200

[Install]
WantedBy=default.target
