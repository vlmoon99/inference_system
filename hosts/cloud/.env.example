# Copy to .env on the node. The same API_KEY on every node, so a project keeps working after a failover.
TAILNET_IP=                 # this node's tailnet address: the gateway listens only there
API_KEY=                    # what projects send as "Authorization: Bearer …" to :8011
NEARAI_API_KEY=             # chat and embeddings (NEAR AI Cloud)
COMFY_API_KEY=              # pictures (Comfy Cloud)
IMAGE_QUALITY=low           # low | medium | high: 0.5, 0.75 or 1.0 of each side is painted, then resized up
# CLOUD_PORT=8011
# CLOUD_IMAGE_PORT=8012
