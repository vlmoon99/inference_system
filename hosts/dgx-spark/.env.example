SEARXNG_SECRET=
TAILNET_IP=100.64.0.1
HF_CACHE=
COMFY_DIR=
LITELLM_MASTER_KEY=
LITELLM_DB_PASSWORD=
AGENT_TOKEN=
LLM_GPU_UTIL=0.26
ADMIN_NODES=dgx-spark=http://100.64.0.1:8090,dgx-spark-2=http://100.64.0.12:8090
IMAGE_API_KEY=
IMAGE_HEALTH=http://127.0.0.1:8102
HOST_NAME=dgx-spark                # the name the admin shows for this node
NODES=                          # every node in priority order, "tailnetIP[/lanIP] ..." (same on all nodes)
ENGINE_KEY=                     # random, same on all nodes: the engines accept only the gateways
REPL_PASSWORD=                  # random, same on all nodes: followers stream the gateway database with it
ALERT_URL=                      # empty = off. Gets {"text": "..."} on takeover, a node or engine down, a missed backup
OFFSITE_REMOTE=                 # empty = off. An rclone remote for the encrypted dumps, e.g. :s3,provider=Cloudflare,access_key_id=…,secret_access_key=…,endpoint=https://<account>.r2.cloudflarestorage.com:<bucket>/inference
OFFSITE_PASSPHRASE=             # encrypts the off-site copy. Keep a copy of it OUTSIDE the Sparks
