# Copy to .env. The key is what projects send as "Authorization: Bearer …" (BoostContent: INFERENCE_KEY).
API_KEY=
PORT=8000
BIND=0.0.0.0                       # Docker Desktop reaches the host through host.docker.internal
MODELS_DIR=$HOME/.cache/inf-mac/models
LLM_PORT=8001                      # MTPLX, this Mac only
# IMAGE_RENDER_SCALE=0.75          # paint smaller and resize up: faster, softer
# IMAGE_STEPS=4
