# ads-worker on the 3090 box. Copy to /opt/ads/worker.env, fill in, chmod 600.
# Everything else about the worker: deploy/worker-box/worker.env.example.

# Shared queue database over the tailnet, as the RESTRICTED role
# (created on the Spark with: make db-worker-role WORKER_DB_PASSWORD=...).
DATABASE_URL=postgresql+asyncpg://ads_worker:CHANGE_ME@100.64.0.1:5433/adsystem

# Identity minted on Admin → Executors ("+ Register executor"), shown once.
EXECUTOR_TOKEN=adx_paste-your-token-here

# Claims come from what THIS box's services advertise (no video → no shorts).
EXECUTOR_CLAIMS=auto
QUEUE_CONCURRENCY=3

# This box's own services first; the Spark second where it makes sense.
LLM_BASE_URL=http://localhost:8010/v1
LLM_MODEL=nvidia/Qwen3.6-35B-A3B-NVFP4
GEN_IMAGE_URL=http://localhost:8102
GEN_VIDEO_URL=http://localhost:8104
# The brand voices (StyleTTS2-multi "Юрій Кудрявець", RadTTS mykyta, F5 ru) live on the
# Spark; this box only has kokoro/piper. Spark FIRST, local second — a short rendered
# here still speaks with the brand voice; local piper is only the fallback if the
# Spark's TTS is down. (A pinned engine the local service lacks answers 503 and the
# pool fails over anyway; the order just saves the round-trip.)
GEN_TTS_URL=http://100.64.0.1:8105,http://localhost:8105

# Generated files cache (durable copies go to the blob store either way).
ASSETS_DIR=/opt/ads/data/assets
